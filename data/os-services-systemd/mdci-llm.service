[Unit]
Description=MDCI LLM model daemon (qwen via Ollama)
After=network.target

[Service]
Type=simple
User=mdci-llm
Group=mdci-llm
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/mdci-llm/models
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
