[Unit]
Description=MDCI LLM model daemon (the runtime /etc/mdci-llm-runtime.env names)
After=network.target

[Service]
Type=simple
User=mdci-llm
Group=mdci-llm
Environment=HOME=/var/lib/mdci-llm
WorkingDirectory=/var/lib/mdci-llm
ExecStart=/usr/local/bin/mdci-llm-run
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
