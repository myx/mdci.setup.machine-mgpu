#!/bin/sh
# One-command overview: the model daemon, the GPU, and the pulled models.
echo "== model daemon =="
systemctl is-active mdci-llm.service 2>&1 || true
echo "== gateway =="
systemctl is-active nginx 2>&1 || true
echo "== accelerator =="
case "${MDCI_ACCELERATOR:-nvidia}" in
	nvidia) nvidia-smi 2>&1 || echo "nvidia-smi unavailable" ;;
	amd) rocm-smi 2>&1 || echo "rocm-smi unavailable (planned)" ;;
	*) echo "unknown accelerator: ${MDCI_ACCELERATOR}" ;;
esac
echo "== models =="
[ -f /etc/mdci-llm-runtime.env ] || { echo "ERROR: /etc/mdci-llm-runtime.env is missing, so the runtime is unknown" >&2; exit 1; }
. /etc/mdci-llm-runtime.env
addr="${MDCI_MODEL_ADDR:-127.0.0.1:11434}"
case "${MDCI_MODEL_RUNTIME}" in
	ollama) curl -fsS --max-time 10 "http://${addr}/api/tags" 2>/dev/null | jq -r '.models[]?.name' 2>/dev/null || echo "(daemon not answering)" ;;
	vllm)   curl -fsS --max-time 10 "http://${addr}/v1/models" 2>/dev/null | jq -r '.data[]?.id' 2>/dev/null || echo "(daemon not answering)" ;;
	*)      echo "unknown runtime: ${MDCI_MODEL_RUNTIME}" ;;
esac
